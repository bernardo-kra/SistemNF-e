{
  "name": "sistem-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.0 <23 || >=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.local/development/api.env --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=.local/development/api.env --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "a1:keys": "node --import tsx scripts/a1-keyring.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --import tsx --test --test-concurrency=1 --test-reporter=./test/redacted-reporter.mjs \"test/*.test.ts\"",
    "setup:neon": "node --env-file-if-exists=../.env.local --env-file-if-exists=../.env --import tsx scripts/setup-neon.ts",
    "setup:neon:owner": "node --env-file-if-exists=../.env.local --env-file-if-exists=../.env --env-file=../.env.neon.local --import tsx scripts/setup-neon-owner.ts",
    "admin": "node --env-file-if-exists=.local/development/api.env --env-file-if-exists=../.env.local --env-file-if-exists=../.env.neon.local --env-file-if-exists=.env.admin.local --import tsx scripts/administration.ts",
    "smoke:neon": "node --env-file-if-exists=../.env.local --env-file-if-exists=../.env --import tsx test/neon-browser-smoke.ts --run",
    "db:local": "node --import tsx scripts/local-postgres.ts",
    "setup:local": "node --import tsx scripts/setup-local.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/static": "10.1.10",
    "better-auth": "1.7.10",
    "fastify": "5.12.7",
    "libxml2-wasm": "0.7.2",
    "node-forge": "1.4.2",
    "pg": "8.23.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/node-forge": "1.3.14",
    "@types/pg": "8.23.1",
    "embedded-postgres": "18.4.0-beta.17",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "xml-crypto": "6.4.0"
  }
}
